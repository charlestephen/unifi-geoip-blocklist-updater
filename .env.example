# Copy to .env and fill in your values
MAXMIND_LICENSE_KEY=your_maxmind_license_key_here
UNIFI_URL=https://your-unifi-controller-ip
UNIFI_API_KEY=your_unifi_api_key_here
UNIFI_SITE=default
GROUP_PREFIX=GeoIPBlock
CHUNK_SIZE=10000
INTERVAL=24h
DRY_RUN=false
INSECURE=false
AGGREGATE=true
TZ=America/New_York
